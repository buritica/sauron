# Sauron gitignore

# Data directories - contains persistent state
data/

# Environment variables with secrets
.env

# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
.claude/

# Grafana Cloud OTLP gateway token (mounted into the alloy container; used
# by otelcol.auth.basic in config/alloy/config.alloy — one Cloud Access
# Policy token scoped to metrics:write + logs:write + traces:write covers
# the unified OTLP gateway push for all three signals)
config/alloy/grafana-cloud-password
