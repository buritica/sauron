# Sauron gitignore

# Data directories - contains persistent state
data/

# Environment variables with secrets
.env

# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
.claude/

# Grafana Cloud API token (mounted into the alloy container; used for both
# the Prometheus remote_write and Loki push basic_auth blocks in
# config/alloy/config.alloy — one Cloud Access Policy token scoped to
# metrics:write + logs:write covers both, or split into two files if you
# prefer separately-scoped tokens per signal)
config/alloy/grafana-cloud-password
